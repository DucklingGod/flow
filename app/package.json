{
  "name": "flow-wealth-studio",
  "private": true,
  "version": "1.0.0-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:critical": "node scripts/critical-journey-e2e.mjs",
    "test:e2e:cross-browser": "node scripts/cross-browser-critical.mjs",
    "test:e2e:llm-connectors": "node scripts/llm-connector-e2e.mjs",
    "test:e2e:acceptance": "node scripts/acceptance-snapshot-e2e.mjs",
    "test:e2e:studio-interactions": "node scripts/studio-interactions-e2e.mjs",
    "test:a11y": "node scripts/axe-accessibility.mjs",
    "test:a11y:layout": "node scripts/responsive-accessibility.mjs",
    "evidence:external-review": "node scripts/generate-external-review-bundle.mjs",
    "verify:external-review": "node scripts/verify-external-review-response.mjs",
    "test:review-verifier": "node --test scripts/review-evidence-integrity.test.mjs",
    "check:boundaries": "node scripts/release-boundary-scan.mjs",
    "test:watch": "vitest",
    "tunnel": "node scripts/start-ngrok.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "dexie": "^4.4.4",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "4.12.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "oxlint": "^1.75.0",
    "playwright": "1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
